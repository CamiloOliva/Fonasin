Options -MultiViews -Indexes
RewriteEngine On

# Release archives are staging artifacts, never public site content.
RewriteRule ^\.deploy(?:/|$) - [F,L,NC]

# Serve real files and directories without rewriting them.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# React Router handles all remaining client-side routes.
RewriteRule ^ index.html [L]
